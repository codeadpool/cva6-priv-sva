# PROBE: EXPECTED TO FAIL in bmc. WAIT_GRANT drives req_port_o.data_req
# unconditionally while allow_access is only read in PTE_LOOKUP, so a PMP-denied
# PTE address is put on the memory interface before the verdict is enforced.
# F11: line anchors, GOLDEN v5.3.0 (2ef1c1b1): request :383, verdict :561.
# on upstream master e4184b66 the same sites are :403 and :598,
# prhead_ptw_req.sby, runs this checker against the fork checkout
[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 15
prove: mode prove
prove: depth 15
cover: mode cover
cover: depth 20

[engines]
bmc:   smtbmc boolector
prove: smtbmc boolector
cover: smtbmc boolector

[script]
plugin -i slang
read_slang --top ptw_fv config_pkg.sv cv64a6_imafdc_sv39_config_pkg.sv riscv_pkg.sv build_config_pkg.sv lzc.sv cf_math_pkg.sv ariane_pkg.sv pmp_entry.sv pmp.sv cva6_ptw.sv ptw_pmp_req_sva.sv ptw_fv.sv ptw_pmp_req_bind.sv
prep -top ptw_fv

